# 时区配置
TZ=Asia/Shanghai

# HA 调度核心配置
DATABASE_URL=postgres://task_center:task_center@postgres:5432/task_center
REDIS_URL=redis://redis:6379
ACCESS_TOKEN=change-me

# Admin API 和内置 SPA
ADMIN_BIND_ADDR=0.0.0.0:8080

# Worker 实例配置
WORKER_ID=worker-1
WORKER_LABELS=executor=http,builtin=bugutv_checkin,trusted=true
WORKER_MAX_CONCURRENCY=4
WORKER_HEARTBEAT_INTERVAL_SECONDS=10
WORKER_OFFLINE_AFTER_SECONDS=30

# Shell executor 默认关闭，只应在可信 worker 上启用
ENABLE_SHELL_EXECUTOR=false
SHELL_ALLOWED_COMMANDS=echo,curl

# Telegram 通知配置（可选）
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Bugutv 内置任务凭据在 admin 中创建任务时写入 config_json，例如：
# {"username":"your_username","password":"your_password"}
# 无头浏览器版本如需指定浏览器路径，可在 worker 环境中设置：
# CHROME_PATH=/usr/bin/chromium
